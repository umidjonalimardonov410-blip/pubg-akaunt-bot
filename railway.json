{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm vite build && pnpm esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "watchPatterns": ["/client/src/**", "/server/**", "/shared/**"]
  },
  "deploy": {
    "startCommand": "node dist/index.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
